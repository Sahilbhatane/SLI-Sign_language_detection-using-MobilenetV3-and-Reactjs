# FastAPI Backend Configuration
# Copy this file to .env and update values as needed

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
RELOAD=True

# CORS Configuration
# For development: use "*" for all origins
# For production: set to your Vercel frontend URL
ALLOWED_ORIGINS=*
# Example for production:
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.your-app.com

# Model Configuration
MODEL_PATH=./backend/model_v2.onnx
LABELS_PATH=./backend/class_labels.txt

# MediaPipe Tasks hand landmarker bundle (.task). If unset or missing, the server
# downloads Google's hand_landmarker.task once into backend/.cache/
# MEDIAPIPE_HAND_MODEL_PATH=

# Inference behavior
# ENABLE_MEDIAPIPE_CROP: 0 (default) feeds the FULL frame to the classifier, which is
#   how it was trained (data/ holds full upper-body frames). Set to 1 ONLY with a model
#   retrained on hand crops (ML/preprocess_hands.py); enabling it on the full-frame model
#   collapses accuracy (measured 98.5% -> 27.1% on the dataset).
ENABLE_MEDIAPIPE_CROP=0
# ENABLE_HAND_GATING: 1 (default) returns "Detecting..." when no hand is visible so empty
#   frames don't produce confident garbage. Set 0 to always predict on the full frame.
ENABLE_HAND_GATING=1
# PRED_SMOOTHING_WINDOW: 1 (default) keeps the backend stateless. The single global model
#   instance serves all clients, so a >1 rolling buffer averages probabilities across
#   unrelated frames/sessions. Per-stream smoothing is handled on the frontend.
PRED_SMOOTHING_WINDOW=1
# MEDIAPIPE_NUM_HANDS: 2 (default) detects and overlays both hands (ISL signs are often two-handed).
MEDIAPIPE_NUM_HANDS=2
# MEDIAPIPE_RUNNING_MODE: video (default) uses temporal tracking -> palm detector only
#   re-runs when the hand is lost (~1.6-1.9x faster on CPU for a live stream). Use 'image'
#   for scoring unrelated still frames.
MEDIAPIPE_RUNNING_MODE=video
# MEDIAPIPE_MAX_SIDE: downscale longest side before hand detection (landmarks are
#   normalized, so overlay/crop coords are unchanged). ~320 is faster AND more reliable
#   than full 640px. 0 disables downscaling.
MEDIAPIPE_MAX_SIDE=320
# ORT_INTRA_OP_THREADS: onnxruntime intra-op CPU threads (0/unset = auto = physical cores).
# ORT_INTRA_OP_THREADS=0

# Logging Configuration
LOG_LEVEL=INFO

# Performance
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
REQUEST_TIMEOUT=30  # seconds

# Translation upstream (LibreTranslate-compatible)
LIBRETRANSLATE_URL=https://libretranslate.com

# Optional TTS
ENABLE_GTTS=0
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional LLM / VLM
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_VLM_MODEL=gpt-4o
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Optional WebRTC processing
WEBRTC_FRAME_STRIDE=3
WEBRTC_MIN_CONFIDENCE=0.6
