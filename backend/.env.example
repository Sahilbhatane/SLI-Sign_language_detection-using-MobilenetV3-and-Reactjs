# FastAPI Backend Configuration
# Copy this file to .env and update values as needed

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
RELOAD=True

# CORS Configuration
# For development: use "*" for all origins
# For production: set to your Vercel frontend URL
ALLOWED_ORIGINS=*
# Example for production:
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.your-app.com

# Model Configuration
MODEL_PATH=./backend/model_v2.onnx
LABELS_PATH=./backend/class_labels.txt

# MediaPipe Tasks hand landmarker bundle (.task). If unset or missing, the server
# downloads Google's hand_landmarker.task once into backend/.cache/
# MEDIAPIPE_HAND_MODEL_PATH=

# Logging Configuration
LOG_LEVEL=INFO

# Performance
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
REQUEST_TIMEOUT=30  # seconds

# Translation upstream (LibreTranslate-compatible)
LIBRETRANSLATE_URL=https://libretranslate.com

# Optional TTS
ENABLE_GTTS=0
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional LLM / VLM
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_VLM_MODEL=gpt-4o
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Optional WebRTC processing
WEBRTC_FRAME_STRIDE=3
WEBRTC_MIN_CONFIDENCE=0.6
